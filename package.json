{
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^20.9.0",
    "npm": "^10.1.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:debug": "eslint --debug .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/eslint__js": "^9.14.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}
